#!/usr/bin/env bash
#
# a_c_claude_memory - make the global ~/.claude/CLAUDE.md a GENERATED file.
#
# The rules file loads on every request, and on most machines it is the one thing
# that is hand-typed and version-controlled nowhere. This composes it from source
# files that DO live in git, between markers, and leaves everything outside the
# markers alone.
#
# Sources, in the order they are rendered:
#   1. core      $MY_WORKFLOW_DIR/memory/core-rules.md        (generic, public)
#   2. machine   $A_CLAUDE_OVERLAY_DIR/machine/$A_MACHINE_NAME.md   (identity + role)
#   3. rules     $A_CLAUDE_OVERLAY_DIR/machine/rules.md       (personal always-on rules)
#   4. glossary  $A_CLAUDE_OVERLAY_DIR/machine/glossary.md    (shorthand -> what to do)
#   5. pointers  generated here from the configured repo paths
#
# Everything but (1) is optional: a machine with no overlay still gets a valid file.
#
# Usage:
#   a_c_claude_memory build     # regenerate the managed region in place
#   a_c_claude_memory diff      # show what build would change (no writes)
#   a_c_claude_memory status    # sources found, region present, in sync?
#   a_c_claude_memory check     # exit 1 if out of sync (for doctor/CI)
#   a_c_claude_memory render    # print the region to stdout
#
# Flags: -n/--dry-run (same as diff for build), -f/--file <path> (target file)

set -euo pipefail

BEGIN_MARK='<!-- >>> agentic-devkit: managed memory >>> -->'
END_MARK='<!-- <<< agentic-devkit: managed memory <<< -->'
# Superseded by the region above; absorbed and removed on build.
OLD_BEGIN='<!-- >>> agentic-devkit hint >>> -->'
OLD_END='<!-- <<< agentic-devkit hint <<< -->'

TARGET="${CLAUDE_MEMORY_FILE:-$HOME/.claude/CLAUDE.md}"
DRY_RUN=0
CMD=""

if [ -t 1 ]; then
  R=$'\033[0m'; B=$'\033[0;34m'; G=$'\033[0;32m'; Y=$'\033[0;33m'; RED=$'\033[0;31m'; D=$'\033[2m'
else
  R=""; B=""; G=""; Y=""; RED=""; D=""
fi

die() { echo "${RED}error:${R} $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    build|diff|status|check|render) CMD="$1"; shift ;;
    -n|--dry-run) DRY_RUN=1; shift ;;
    -f|--file) TARGET="${2:-}"; [ -n "$TARGET" ] || die "-f needs a path"; shift 2 ;;
    -h|--help) sed -n '3,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done
[ -n "$CMD" ] || CMD="status"

[ -n "${MY_WORKFLOW_DIR:-}" ] || die "MY_WORKFLOW_DIR is not set. Source your profile first."
CORE="$MY_WORKFLOW_DIR/memory/core-rules.md"
[ -f "$CORE" ] || die "core rules missing: $CORE"

OVERLAY="${A_CLAUDE_OVERLAY_DIR:-}"
BRAIN="${A_CLAUDE_BRAIN_DIR:-}"
MACHINE="${A_MACHINE_NAME:-}"

MACHINE_FILE=""
RULES_FILE=""
GLOSSARY_FILE=""
if [ -n "$OVERLAY" ] && [ -d "$OVERLAY" ]; then
  [ -n "$MACHINE" ] && [ -f "$OVERLAY/machine/$MACHINE.md" ] && MACHINE_FILE="$OVERLAY/machine/$MACHINE.md"
  [ -f "$OVERLAY/machine/rules.md" ]    && RULES_FILE="$OVERLAY/machine/rules.md"
  [ -f "$OVERLAY/machine/glossary.md" ] && GLOSSARY_FILE="$OVERLAY/machine/glossary.md"
fi

# --- render the managed region -------------------------------------------------

render_region() {
  echo "$BEGIN_MARK"
  echo "<!--"
  echo "  GENERATED by a_c_claude_memory. Do not edit inside these markers - the next"
  echo "  build overwrites it. Edit the source file, then run: a_c_claude_memory build"
  echo ""
  echo "  core     $CORE"
  [ -n "$MACHINE_FILE" ]  && echo "  machine  $MACHINE_FILE"
  [ -n "$RULES_FILE" ]    && echo "  rules    $RULES_FILE"
  [ -n "$GLOSSARY_FILE" ] && echo "  glossary $GLOSSARY_FILE"
  echo "  pointers generated from A_CLAUDE_OVERLAY_DIR / A_CLAUDE_BRAIN_DIR"
  echo "-->"
  echo ""
  echo "# Global guidance"
  echo ""
  cat "$CORE"

  if [ -n "$MACHINE_FILE" ]; then
    echo ""
    strip_frontmatter "$MACHINE_FILE"
  fi
  if [ -n "$RULES_FILE" ]; then
    echo ""
    strip_frontmatter "$RULES_FILE"
  fi
  if [ -n "$GLOSSARY_FILE" ]; then
    echo ""
    strip_frontmatter "$GLOSSARY_FILE"
  fi

  echo ""
  echo "## Where things live"
  echo ""
  echo "| Repo | Path | Holds |"
  echo "|---|---|---|"
  echo "| **agentic-devkit** (core) | \`$MY_WORKFLOW_DIR\` | generic skills, agents, shell wiring, tools |"
  if [ -n "$OVERLAY" ]; then
    echo "| **private overlay** | \`$OVERLAY\` | personal-only skills, machine identity, glossary |"
  fi
  if [ -n "$BRAIN" ]; then
    echo "| **private brain** | \`$BRAIN\` | knowledge: projects, decisions, setups, trackers |"
  fi
  echo ""
  echo "After a \`git pull\` in a devkit repo, re-link with \`./install.sh\` in that repo, then"
  echo "run \`a_c_claude_memory build\` if its memory sources changed. The model behind this"
  echo "layout: \`$MY_WORKFLOW_DIR/docs/managed-claude.md\`."

  if [ -n "$BRAIN" ]; then
    echo ""
    echo "## The brain - check it before answering from memory"
    echo ""
    echo "Path: \`$BRAIN\`. **Read its \`CLAUDE.md\` first** - it says which folder answers which"
    echo "kind of question, so you do not have to read or guess at the rest."
    echo ""
    echo "If the path is missing (unmounted volume, a different machine), **skip it silently**. A"
    echo "missing brain must never block a session."
    echo ""
    echo "When a session produces something durable - a correction, a preference, a decision, a"
    echo "repo or person Claude did not know - write it back with \`a_sk_teach_claude\`."
  fi

  echo "$END_MARK"
}

# A source file may carry YAML frontmatter for its own tooling; it is metadata, not content.
strip_frontmatter() {
  awk 'NR==1 && $0=="---" {fm=1; next} fm && $0=="---" {fm=0; next} !fm {print}' "$1"
}

# --- assemble the whole file ---------------------------------------------------

# Drop the superseded hint block, if a previous a_sk_setup_claude run left one.
strip_old_hint() {
  awk -v b="$OLD_BEGIN" -v e="$OLD_END" '
    $0==b {skip=1; next} $0==e {skip=0; next} !skip {print}
  '
}

build_file() {
  local tmp region_file
  tmp="$(mktemp)"
  # The region goes to a FILE, never through `awk -v`: awk rejects embedded
  # newlines in a -v assignment, and the failure mode is a truncated rules file.
  region_file="$(mktemp)"
  render_region > "$region_file"

  if [ ! -f "$TARGET" ]; then
    cat "$region_file" > "$tmp"
  elif grep -qF "$BEGIN_MARK" "$TARGET" && grep -qF "$END_MARK" "$TARGET"; then
    # Replace in place, preserving hand-written text on both sides.
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" -v f="$region_file" '
      $0==b {while ((getline line < f) > 0) print line; close(f); inblock=1; next}
      $0==e {inblock=0; next}
      !inblock {print}
    ' "$TARGET" | strip_old_hint > "$tmp"
  else
    # First build on a hand-written file: region goes first, existing content is
    # kept below it untouched, so nothing is ever lost to adoption.
    {
      cat "$region_file"
      echo ""
      echo "<!-- Hand-written below this line. a_c_claude_memory never touches it. -->"
      echo ""
      strip_old_hint < "$TARGET"
    } > "$tmp"
  fi
  rm -f "$region_file"
  printf '%s' "$tmp"
}

case "$CMD" in
  render)
    render_region
    ;;

  build)
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      echo "${G}up to date${R} ${D}$TARGET${R}"
      rm -f "$tmp"
      exit 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "${B}would change${R} $TARGET ${D}(dry run)${R}"
      diff -u "$TARGET" "$tmp" 2>/dev/null | sed 's/^/  /' || true
      rm -f "$tmp"
      exit 0
    fi
    if [ -f "$TARGET" ]; then
      bk="$TARGET.bak.$(date +%Y%m%dT%H%M%S)"
      cp "$TARGET" "$bk"
      echo "${D}backup: $bk${R}"
    else
      mkdir -p "$(dirname "$TARGET")"
    fi
    mv "$tmp" "$TARGET"
    echo "${G}built${R} $TARGET ${D}($(wc -l < "$TARGET" | tr -d ' ') lines)${R}"
    ;;

  diff)
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      echo "${G}in sync${R} ${D}$TARGET${R}"
    else
      diff -u "$TARGET" "$tmp" 2>/dev/null || true
    fi
    rm -f "$tmp"
    ;;

  check)
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      rm -f "$tmp"; echo "${G}ok${R} memory in sync"; exit 0
    fi
    rm -f "$tmp"
    echo "${Y}drift${R} $TARGET differs from its sources - run: a_c_claude_memory build" >&2
    exit 1
    ;;

  status)
    echo "${B}target${R}   $TARGET"
    if [ -f "$TARGET" ]; then
      echo "         $(wc -l < "$TARGET" | tr -d ' ') lines"
      if grep -qF "$BEGIN_MARK" "$TARGET"; then
        echo "         ${G}managed region present${R}"
      else
        echo "         ${Y}no managed region yet${R} ${D}(run: a_c_claude_memory build)${R}"
      fi
    else
      echo "         ${Y}does not exist yet${R}"
    fi
    echo "${B}machine${R}  ${MACHINE:-${Y}A_MACHINE_NAME unset${R}}"
    echo "${B}sources${R}"
    printf "  %-9s %s\n" "core" "$CORE"
    for pair in "machine:$MACHINE_FILE" "rules:$RULES_FILE" "glossary:$GLOSSARY_FILE"; do
      k="${pair%%:*}"; v="${pair#*:}"
      if [ -n "$v" ]; then printf "  %-9s %s\n" "$k" "$v"
      else printf "  %-9s ${D}(none)${R}\n" "$k"; fi
    done
    printf "  %-9s %s\n" "overlay" "${OVERLAY:-${D}(unset)${R}}"
    printf "  %-9s %s\n" "brain" "${BRAIN:-${D}(unset)${R}}"
    tmp="$(build_file)"
    if [ -f "$TARGET" ] && cmp -s "$tmp" "$TARGET"; then
      echo "${G}in sync${R}"
    else
      echo "${Y}out of sync${R} ${D}- a_c_claude_memory diff${R}"
    fi
    rm -f "$tmp"
    ;;
esac

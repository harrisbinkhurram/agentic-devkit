#!/bin/bash
# a_s_unity_hub — keep Unity Hub's project list in sync with git worktrees.
#
# Unity Hub has no CLI command to add a project (its --headless interface only
# covers editors and install paths), so the project list is edited directly on
# disk.
#
# A git worktree of a Unity repo is a complete Unity project (it has Assets/,
# Packages/ and ProjectSettings/), so the Hub is happy to list it — it just
# never learns the folder exists unless someone clicks "Add project from disk".
# This script does that step for us.
#
# WHERE THE LIST LIVES (this changed in Hub 3.21)
#
# Up to Hub 3.20 the list was one file:
#   ~/Library/Application Support/UnityHub/projects-v1.json
#
# Hub 3.21 moved it to SQLite:
#   ~/Library/Application Support/UnityHub/hub.db     (table `projects`)
#
# On first launch of 3.21 the Hub imports projects-v1.json into hub.db once and
# records that in `meta.projects_json_migrated`. From then on hub.db is the only
# source of truth, and projects-v1.json is demoted to two lesser jobs:
#
#   1. a first-paint cache — readProjectsSnapshotSync() reads it synchronously
#      at window construction and shows the first 20 entries before any service
#      has started;
#   2. a downgrade mirror — persistCompatibilityMirror() rewrites it from the
#      Hub's in-memory list on shutdown.
#
# So a JSON-only write on 3.21+ produces exactly the "it was there, then it went
# away" symptom: the entry paints from the cache, then ~5s later the project
# service finishes loading hub.db ("LocalProject: Forced refresh: Projects data
# will be re-collected" in the Hub log) and the renderer replaces the list with
# the DB's — which never had the entry. The shutdown mirror then overwrites the
# JSON, erasing the last trace.
#
# This script therefore writes to hub.db when hub.db is authoritative, and keeps
# projects-v1.json in step so the first-paint cache does not flash a stale list.
# When there is no hub.db, or the one-time import has not run yet, the JSON is
# still authoritative and is written alone, exactly as before.
#
# Commands:
#   a_s_unity_hub add <path> [--title T] [--restart]
#   a_s_unity_hub remove <path> [--restart]
#   a_s_unity_hub sync [<worktrees-root>...] [--prune] [--restart]
#   a_s_unity_hub list
#
# Non-Unity paths are skipped silently, so callers can invoke this for every
# worktree without checking the project type first.

set -uo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

HUB_DIR="$HOME/Library/Application Support/UnityHub"
HUB_JSON="$HUB_DIR/projects-v1.json"
HUB_DB="$HUB_DIR/hub.db"
HUB_APP="/Applications/Unity Hub.app"

RESTART_HUB=false
PRUNE=false

usage() {
    cat <<'EOF'
Usage:
  a_s_unity_hub add <project-path> [--restart]
  a_s_unity_hub remove <project-path> [--restart]
  a_s_unity_hub sync [<worktrees-root>...] [--prune] [--restart]
  a_s_unity_hub list

Adds git worktrees (or any Unity project folder) to the Unity Hub project list
so they show up without "Add project from disk".

With no root, sync uses the WorkTrees directory that belongs to the repo you are
standing in (the sibling of its main checkout), so a bare `a_s_unity_hub sync`
sweeps every worktree of every repo in that workspace.

Options:
  --prune    With sync: also drop listed projects under the given roots whose
             folder no longer exists on disk. Never touches projects outside
             those roots.
  --restart  Quit Unity Hub before writing and reopen it afterwards. The Hub
             loads the project list at launch and keeps it in memory, so
             without a restart the change is invisible until you relaunch.

Notes:
  • Paths that are not Unity projects (no ProjectSettings/ProjectVersion.txt)
    are skipped without an error.
  • Hub 3.21+ keeps the list in hub.db (SQLite); older Hubs use
    projects-v1.json. This writes whichever one the Hub will actually read and
    mirrors into the other. `list` prints which store is in force. On 3.21+,
    sqlite3 is required — without it a write would land only in the JSON, which
    the Hub uses as a startup cache, so the entry would appear and then vanish
    a few seconds later when the real list loads.
  • For a worktree, Unity cloud/organization fields are inherited from the main
    checkout's entry so the Hub links it to the same Unity project.
  • The Hub names a project after its folder and re-derives that name at every
    launch for any entry it did not rename itself, so this script does not try
    to inject a nicer title — a worktree folder is already the branch name with
    slashes turned into dashes (carsort/feature/glass-cover ->
    carsort-feature-glass-cover). To pin a different name, rename the project
    inside the Hub; that sticks, and this script never overwrites it.
EOF
}

die() { echo -e "${RED}Error: $*${NC}" >&2; exit 1; }

require_hub_json() {
    [ -f "$HUB_JSON" ] && return 0
    # A profile that has only ever run Hub 3.21+ may have no JSON mirror yet.
    # Seed an empty one rather than refusing to work.
    if db_authoritative; then
        printf '%s' '{"schema_version":"v1","data":{}}' > "$HUB_JSON" \
            || die "could not create $HUB_JSON"
        return 0
    fi
    die "Unity Hub project list not found at $HUB_JSON
Open Unity Hub once so it creates the file, then retry."
}

# ── hub.db (Hub 3.21+) ────────────────────────────────────────────────────────
# The Hub keeps the list in SQLite once its one-time JSON import has run. Until
# then (or on older Hubs) the JSON is still the source of truth. See the header.

# Escape a value for a single-quoted SQL literal.
sql_quote() { printf "%s" "$1" | sed "s/'/''/g"; }

# sqlite3 with a busy timeout: the Hub may hold the DB while it is running.
hub_sql() { sqlite3 -cmd '.timeout 5000' "$HUB_DB" "$@"; }

# Which store will the Hub actually read at its next launch? One of:
#   none          no hub.db — a pre-3.21 Hub, the JSON is the list
#   nosqlite      hub.db exists but we have no sqlite3 to reach it
#   unreadable    hub.db exists but will not answer (corrupt, or locked past
#                 the busy timeout by a Hub mid-write)
#   unmigrated    hub.db exists but has not imported the JSON yet, so the JSON
#                 is still the list and the Hub will import it at next launch
#   authoritative hub.db is the list
# The two failure states matter: a JSON-only write there looks like it worked
# and then undoes itself, which is the bug this script used to have.
DB_STATE=""
db_probe() {
    [ -n "$DB_STATE" ] && return 0
    if [ ! -f "$HUB_DB" ]; then DB_STATE=none; return 0; fi
    if ! command -v sqlite3 >/dev/null 2>&1; then DB_STATE=nosqlite; return 0; fi
    if ! hub_sql "SELECT count(*) FROM projects;" >/dev/null 2>&1; then
        DB_STATE=unreadable; return 0
    fi
    if [ -n "$(hub_sql "SELECT value FROM meta WHERE key='projects_json_migrated';" 2>/dev/null)" ]; then
        DB_STATE=authoritative
    else
        DB_STATE=unmigrated
    fi
}

db_authoritative() { db_probe; [ "$DB_STATE" = authoritative ]; }

# Refuse to write when hub.db is the list but we cannot reach it. Falling back
# to the JSON would put the entry somewhere this Hub only reads as a startup
# cache — it would appear, then vanish seconds later. An error beats that.
db_require_usable() {
    db_probe
    case "$DB_STATE" in
        none|authoritative) return 0 ;;
        unmigrated)
            echo -e "${YELLOW}hub.db exists but has not imported projects-v1.json yet;"
            echo -e "writing the JSON, which the Hub will import at its next launch.${NC}"
            ;;
        nosqlite)
            die "This Unity Hub keeps its project list in
  $HUB_DB
but sqlite3 is not installed, so it cannot be written. Writing only
projects-v1.json would make entries appear in the Hub and then vanish a few
seconds later, because this Hub uses that file as a startup cache.
Install sqlite3 (brew install sqlite) and retry."
            ;;
        unreadable)
            die "Could not read
  $HUB_DB
It may be corrupt, or Unity Hub may be holding it. Quit Unity Hub and retry —
or use --restart, which quits it for you. Refusing to write projects-v1.json
instead, because this Hub treats that file as a startup cache only, so the
entry would appear and then vanish."
            ;;
    esac
}

# The stored entity for a path, or empty when the row is absent.
db_get() {
    db_authoritative || return 1
    hub_sql "SELECT data FROM projects WHERE path='$(sql_quote "$1")';" 2>/dev/null
}

db_upsert() {
    local path="$1" data="$2" now="$3"
    db_authoritative || return 1
    hub_sql "INSERT INTO projects (path, data, updated_at)
             VALUES ('$(sql_quote "$path")', '$(sql_quote "$data")', $now)
             ON CONFLICT(path) DO UPDATE SET data=excluded.data,
                                             updated_at=excluded.updated_at;" \
        || die "could not write $path to $HUB_DB"
}

db_delete() {
    db_authoritative || return 1
    hub_sql "DELETE FROM projects WHERE path='$(sql_quote "$1")';" \
        || die "could not remove $1 from $HUB_DB"
}

db_paths() {
    db_authoritative || return 1
    hub_sql "SELECT path FROM projects;" 2>/dev/null
}

# Is this folder a Unity project?
is_unity_project() {
    [ -f "$1/ProjectSettings/ProjectVersion.txt" ]
}

# Read a value out of ProjectVersion.txt.
#   $1 = project path, $2 = key (m_EditorVersion | m_EditorVersionWithRevision)
project_version_field() {
    sed -n "s/^$2: *//p" "$1/ProjectSettings/ProjectVersion.txt" | head -1 | tr -d '\r'
}

# The main checkout backing a worktree, or the path itself when it is not a
# worktree. Used as the donor for cloud ids, build target and render pipeline.
donor_path() {
    local p="$1" common
    common=$(git -C "$p" rev-parse --git-common-dir 2>/dev/null) || { echo "$p"; return; }
    case "$common" in
        /*) ;;
        *) common="$p/$common" ;;
    esac
    (cd "$(dirname "$common")" 2>/dev/null && pwd) || echo "$p"
}

# Write the JSON atomically, keeping one backup. Hub's file is a single line;
# jq -c preserves that shape.
write_hub_json() {
    local new="$1" tmp
    tmp=$(mktemp "${TMPDIR:-/tmp}/unityhub-projects.XXXXXX") || die "mktemp failed"
    printf '%s' "$new" > "$tmp" || die "could not write temp file"
    jq empty < "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; die "refusing to write invalid JSON"; }
    cp "$HUB_JSON" "$HUB_JSON.bak" 2>/dev/null
    mv "$tmp" "$HUB_JSON" || die "could not replace $HUB_JSON"
}

# Was the Hub running when we started? Only then do we reopen it afterwards.
HUB_WAS_RUNNING=false

hub_is_running() { pgrep -f "$HUB_APP/Contents/MacOS/Unity Hub" >/dev/null 2>&1; }

# Called BEFORE any write. The Hub rewrites the project list from memory when it
# quits, so quitting after the write can flush our change away.
stop_hub_if_asked() {
    [ "$RESTART_HUB" = true ] || return 0
    hub_is_running || return 0
    HUB_WAS_RUNNING=true
    echo -e "${YELLOW}Quitting Unity Hub before editing its project list…${NC}"
    osascript -e 'tell application "Unity Hub" to quit' >/dev/null 2>&1
    local i=0
    while hub_is_running && [ $i -lt 30 ]; do sleep 0.5; i=$((i + 1)); done
    hub_is_running && die "Unity Hub did not quit — close it and retry."
    sleep 1
}

start_hub_if_asked() {
    [ "$RESTART_HUB" = true ] || return 0
    open -g -a "$HUB_APP" 2>/dev/null
    if [ "$HUB_WAS_RUNNING" = true ]; then
        echo -e "${GREEN}✓ Unity Hub restarted${NC}"
    else
        echo -e "${GREEN}✓ Started Unity Hub${NC}"
    fi
}

warn_if_hub_running() {
    [ "$RESTART_HUB" = true ] && return 0
    if hub_is_running; then
        echo -e "${YELLOW}Unity Hub is running — it loads the project list at launch and keeps it"
        echo -e "in memory, so the change is invisible until you restart the Hub.${NC}"
        echo -e "${BLUE}  a_s_unity_hub add <path> --restart${NC}   does that for you."
    fi
}

# ── add ───────────────────────────────────────────────────────────────────────
cmd_add() {
    local raw="$1" path title
    path=$(cd "$raw" 2>/dev/null && pwd) || die "no such directory: $raw"

    if ! is_unity_project "$path"; then
        echo -e "${BLUE}Not a Unity project, skipping: $path${NC}"
        return 0
    fi
    require_hub_json

    local version revision changeset parent donor
    version=$(project_version_field "$path" m_EditorVersion)
    revision=$(project_version_field "$path" m_EditorVersionWithRevision)
    # "6000.0.67f1 (78a1c2bbeb6a)" -> "78a1c2bbeb6a"
    changeset=$(printf '%s' "$revision" | sed -n 's/.*(\(.*\)).*/\1/p')
    [ -n "$version" ] || die "could not read m_EditorVersion from $path/ProjectSettings/ProjectVersion.txt"

    parent=$(dirname "$path")
    donor=$(donor_path "$path")
    [ "$donor" = "$path" ] && donor=""

    # Match how the Hub names projects: the folder name. Anything else is reset
    # at the Hub's next launch anyway (see the note in --help).
    title=$(basename "$path")

    local now existing src entity updated
    now=$(( $(date +%s) * 1000 ))

    # Read whatever is already stored, from whichever store the Hub will read.
    existing=$(read_entity "$path")
    src="{}"
    [ -n "$donor" ] && src=$(read_entity "$donor")

    entity=$(jq -nc \
        --arg path "$path" \
        --arg parent "$parent" \
        --arg version "$version" \
        --arg changeset "$changeset" \
        --arg title "$title" \
        --argjson src "$src" \
        --argjson existing "$existing" \
        --argjson now "$now" '
        # Fields the Hub copies from the main checkout when one is listed:
        # they identify the Unity cloud project, which a worktree shares.
        ($src | {genesisOrgId, cloudProjectId, organizationId, localProjectId,
                 cloudEnabled, projectName, organizationName, buildTarget,
                 renderPipeline}
              | with_entries(select(.value != null))) as $inherited
        | ({
              isCustomEditor: false,
              isFavorite: false,
              cloudEnabled: true,
              buildTarget: "Android",
              renderPipeline: "URP"
          }
          + $inherited
          # An entry already in the list wins: never clobber a title, favorite
          # flag or build target the user set inside the Hub.
          + $existing
          + {
              path: $path,
              containingFolderPath: $parent,
              version: $version,
              changeset: $changeset,
              architecture: "arm64",
              lastModified: $now
          }
          + (if ($existing | has("title")) then {} else {title: $title, hasCustomDisplayName: false} end))
        ') || die "jq failed while building the project entry"

    # hub.db first — it is what the Hub loads. The JSON is kept in step so the
    # Hub's first-paint cache does not disagree with what loads a moment later.
    db_upsert "$path" "$entity" "$now"

    updated=$(jq -c --arg p "$path" --argjson e "$entity" '.data[$p] = $e' "$HUB_JSON") \
        || die "jq failed while updating $HUB_JSON"
    write_hub_json "$updated"

    if ! verify_entry "$path"; then
        die "entry did not land in the Unity Hub project list"
    fi
    echo -e "${GREEN}✓ Unity Hub: $(printf '%s' "$entity" | jq -r '.title')${NC}"
    echo "  $path  ($version)"
}

# The stored entity for a path from the authoritative store, "{}" when absent.
read_entity() {
    local raw
    if db_authoritative; then
        raw=$(db_get "$1")
        [ -n "$raw" ] && { printf '%s' "$raw"; return; }
        # Fall through: the DB may not have it yet, but the JSON might still
        # carry a title/favorite the user set before the 3.21 migration.
    fi
    jq -c --arg p "$1" '(.data[$p] // {})' "$HUB_JSON" 2>/dev/null || echo '{}'
}

# Did the entry land where the Hub will read it?
verify_entry() {
    if db_authoritative; then
        [ -n "$(db_get "$1")" ]
    else
        jq -e --arg p "$1" '.data[$p]' "$HUB_JSON" >/dev/null 2>&1
    fi
}

# ── remove ────────────────────────────────────────────────────────────────────
cmd_remove() {
    local raw="$1" path updated
    # The folder may already be gone (worktree removed first), so resolve
    # without requiring it to exist.
    path=$(cd "$raw" 2>/dev/null && pwd) || path="${raw%/}"
    require_hub_json

    local in_db=false in_json=false
    verify_entry "$path" && in_db=true
    jq -e --arg p "$path" 'has("data") and (.data | has($p))' "$HUB_JSON" >/dev/null 2>&1 && in_json=true

    if [ "$in_db" = false ] && [ "$in_json" = false ]; then
        echo -e "${BLUE}Not listed in Unity Hub, nothing to remove: $path${NC}"
        return 0
    fi

    db_delete "$path"
    if [ "$in_json" = true ]; then
        updated=$(jq -c --arg p "$path" 'del(.data[$p])' "$HUB_JSON") || die "jq failed"
        write_hub_json "$updated"
    fi
    echo -e "${GREEN}✓ Removed from Unity Hub: $path${NC}"
}

# Every path the Hub currently lists, from the authoritative store.
listed_paths() {
    if db_authoritative; then
        db_paths
    else
        jq -r '.data | keys[]' "$HUB_JSON" 2>/dev/null
    fi
}

# ── sync ──────────────────────────────────────────────────────────────────────
cmd_sync() {
    local roots=("$@") root child
    require_hub_json

    for root in "${roots[@]}"; do
        [ -d "$root" ] || { echo -e "${YELLOW}Skipping missing root: $root${NC}"; continue; }
        root=$(cd "$root" && pwd)
        echo -e "${BLUE}Scanning $root${NC}"

        # One level for <root>/<worktree>, two for <root>/<repo>/<worktree>.
        while IFS= read -r child; do
            [ -d "$child" ] || continue
            is_unity_project "$child" || continue
            cmd_add "$child"
        done < <(find "$root" -mindepth 1 -maxdepth 2 -type d -not -name '.*' 2>/dev/null)

        if [ "$PRUNE" = true ]; then
            local dead
            while IFS= read -r dead; do
                [ -n "$dead" ] || continue
                [ -d "$dead" ] && continue
                cmd_remove "$dead"
            done < <(listed_paths | awk -v r="$root/" 'index($0, r) == 1')
        fi
    done
}

# ── list ──────────────────────────────────────────────────────────────────────
cmd_list() {
    require_hub_json
    if db_authoritative; then
        echo -e "${BLUE}Store: $HUB_DB${NC}"
        sqlite3 -cmd '.timeout 5000' -separator $'\t' "$HUB_DB" \
            "SELECT json_extract(data,'\$.version'),
                    json_extract(data,'\$.title'),
                    path
             FROM projects ORDER BY path;" | column -t -s$'\t'
    else
        echo -e "${BLUE}Store: $HUB_JSON${NC}"
        jq -r '.data | to_entries[] | "\(.value.version)\t\(.value.title)\t\(.key)"' "$HUB_JSON" \
            | sort -t$'\t' -k3 | column -t -s$'\t'
    fi
}

# ── argument parsing ──────────────────────────────────────────────────────────
[ $# -gt 0 ] || { usage; exit 1; }

COMMAND="$1"; shift
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --restart) RESTART_HUB=true ;;
        --prune) PRUNE=true ;;
        -h|--help) usage; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) ARGS+=("$1") ;;
    esac
    shift
done

command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq)"

case "$COMMAND" in
    add)
        [ ${#ARGS[@]} -ge 1 ] || die "add needs a project path"
        stop_hub_if_asked
        # After the quit, so --restart can free a hub.db the Hub was holding.
        db_require_usable
        cmd_add "${ARGS[0]}"
        warn_if_hub_running
        start_hub_if_asked
        ;;
    remove|rm)
        [ ${#ARGS[@]} -ge 1 ] || die "remove needs a project path"
        stop_hub_if_asked
        # After the quit, so --restart can free a hub.db the Hub was holding.
        db_require_usable
        cmd_remove "${ARGS[0]}"
        warn_if_hub_running
        start_hub_if_asked
        ;;
    sync)
        # No root given: use the WorkTrees dir belonging to the repo we're in.
        # a_g_worktree_init puts worktrees in <workspace>/WorkTrees/<repo>/<branch>,
        # where <workspace> is the parent of the main checkout — derive the same
        # place from the git common dir so this works from inside a worktree too.
        if [ ${#ARGS[@]} -eq 0 ]; then
            _common=$(git rev-parse --git-common-dir 2>/dev/null) \
                || die "sync needs a worktrees root (or run it inside a git repo)"
            case "$_common" in /*) ;; *) _common="$PWD/$_common" ;; esac
            _main=$(cd "$(dirname "$_common")" && pwd)
            ARGS=("$(dirname "$_main")/WorkTrees")
            echo -e "${BLUE}No root given — using ${ARGS[0]}${NC}"
        fi
        stop_hub_if_asked
        # After the quit, so --restart can free a hub.db the Hub was holding.
        db_require_usable
        cmd_sync "${ARGS[@]}"
        warn_if_hub_running
        start_hub_if_asked
        ;;
    list|ls) cmd_list ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $COMMAND (try --help)" ;;
esac
